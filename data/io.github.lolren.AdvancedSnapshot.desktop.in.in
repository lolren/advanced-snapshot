[Desktop Entry]
Name=Advanced Snapshot
GenericName=Camera
Comment=Take finely controlled pictures and videos
Type=Application
Exec=advanced-snapshot
Terminal=false
Categories=AudioVideo;Video;Recorder;GNOME;GTK;
