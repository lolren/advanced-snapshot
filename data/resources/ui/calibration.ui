<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="CalibrationDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Camera Calibration</property>
    <property name="content-width">340</property>
    <property name="content-height">680</property>
    <child>
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">14</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">18</property>
            <property name="margin-bottom">18</property>
            <child>
              <object class="GtkLabel" id="camera_label">
                <property name="wrap">True</property>
                <property name="justify">center</property>
                <property name="halign">fill</property>
                <style>
                  <class name="title-2"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="identity_label">
                <property name="wrap">True</property>
                <property name="wrap-mode">char</property>
                <property name="max-width-chars">36</property>
                <property name="selectable">True</property>
                <property name="justify">center</property>
                <property name="halign">fill</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Use a neutral grey card or colour chart in even light. Start with automatic white balance, then turn it off and adjust red and blue gains until the grey target is neutral. The green-cast preset below also switches to manual white balance automatically. Tune Gamma, Colour, Contrast, Detail, Exposure and focus, capture a reference photo, then save the values below for this physical sensor.</property>
                <property name="wrap">True</property>
                <property name="wrap-mode">word-char</property>
                <property name="halign">fill</property>
                <property name="justify">left</property>
                <style>
                  <class name="body"/>
                </style>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Current settings</property>
                <child>
                  <object class="AdwActionRow" id="current_row">
                    <property name="title" translatable="yes">Values in Image Controls</property>
                    <property name="subtitle" translatable="yes">These values are saved exactly as shown.</property>
                    <property name="subtitle-lines">6</property>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Restore manual focus</property>
                    <property name="subtitle" translatable="yes">Keep the saved lens position on startup; leave off for continuous autofocus.</property>
                    <child>
                      <object class="GtkSwitch" id="restore_manual_focus">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Colour matrix calibration</property>
                <property name="description" translatable="yes">Correct camera RGB after white balance. Use a colour chart and keep each row near a total of 1 so neutral grey remains neutral.</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Use custom colour matrix</property>
                    <property name="subtitle" translatable="yes">Applied only with automatic white balance turned off</property>
                    <child>
                      <object class="GtkSwitch" id="custom_colour_matrix">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_00">
                    <property name="title" translatable="yes">M00 · red from red</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="value">1</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_01">
                    <property name="title" translatable="yes">M01 · red from green</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_02">
                    <property name="title" translatable="yes">M02 · red from blue</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_10">
                    <property name="title" translatable="yes">M10 · green from red</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_11">
                    <property name="title" translatable="yes">M11 · green from green</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="value">1</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_12">
                    <property name="title" translatable="yes">M12 · green from blue</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_20">
                    <property name="title" translatable="yes">M20 · blue from red</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_21">
                    <property name="title" translatable="yes">M21 · blue from green</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="ccm_22">
                    <property name="title" translatable="yes">M22 · blue from blue</property>
                    <property name="digits">2</property>
                    <property name="numeric">True</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">-4</property>
                        <property name="upper">4</property>
                        <property name="value">1</property>
                        <property name="step-increment">0.01</property>
                        <property name="page-increment">0.1</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Matrix starting points</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Identity</property>
                    <property name="subtitle" translatable="yes">Neutral matrix with no cross-channel correction</property>
                    <property name="subtitle-lines">2</property>
                    <child>
                      <object class="GtkButton" id="identity_matrix_button">
                        <property name="label" translatable="yes">Use</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Green-cast correction</property>
                    <property name="subtitle" translatable="yes">Moderate grey-preserving correction for a green tint; selects manual white balance</property>
                    <property name="subtitle-lines">2</property>
                    <child>
                      <object class="GtkButton" id="green_cast_matrix_button">
                        <property name="label" translatable="yes">Use</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Colour boost</property>
                    <property name="subtitle" translatable="yes">Preserves grey while separating colours slightly</property>
                    <property name="subtitle-lines">2</property>
                    <child>
                      <object class="GtkButton" id="colour_boost_matrix_button">
                        <property name="label" translatable="yes">Use</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Saved sensor profile</property>
                <child>
                  <object class="AdwActionRow" id="saved_row">
                    <property name="title" translatable="yes">Saved values</property>
                    <property name="subtitle" translatable="yes">No saved profile for this sensor</property>
                    <property name="subtitle-lines">6</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkButton" id="apply_button">
                    <property name="label" translatable="yes">Apply Saved Profile</property>
                    <property name="hexpand">True</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_button">
                    <property name="label" translatable="yes">Save Current Profile</property>
                    <property name="hexpand">True</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="clear_button">
                    <property name="label" translatable="yes">Clear Saved Profile</property>
                    <property name="hexpand">True</property>
                    <style>
                      <class name="destructive-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="wrap">True</property>
                <property name="justify">center</property>
                <property name="halign">fill</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">This profile stores real libcamera controls, including a manual 3×3 colour matrix, white balance, exposure, tone and optional lens position. The matrix can be chart-calibrated, but it does not recreate proprietary lens shading, denoise or multi-frame processing. Keep the reference photo and lighting notes so changes remain reproducible.</property>
                <property name="wrap">True</property>
                <property name="halign">fill</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
