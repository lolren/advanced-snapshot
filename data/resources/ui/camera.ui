<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="Camera" parent="AdwBreakpointBin">
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <style>
      <class name="portrait"/>
    </style>
    <child>
      <object class="AdwBreakpoint" id="single_landscape_bp">
        <condition>max-aspect-ratio: 4/3 or max-height: 600</condition>
        <setter object="multi_layout_view" property="layout-name">single_landscape_bp</setter>
        <setter object="camera_mode_toggles" property="orientation">horizontal</setter>
        <setter object="camera_controls" property="orientation">horizontal</setter>
        <signal name="apply" handler="change_breakpoint" object="Camera" swapped="yes" />
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint" id="dual_portrait_bp">
        <condition>max-height: 400</condition>
        <setter object="multi_layout_view" property="layout-name">dual_portrait_bp</setter>
        <setter object="camera_mode_toggles" property="orientation">vertical</setter>
        <setter object="camera_controls" property="orientation">vertical</setter>
        <signal name="apply" handler="change_breakpoint" object="Camera" swapped="yes" />
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint" id="dual_landscape_bp">
        <condition>max-aspect-ratio: 4/3 and max-width: 500</condition>
        <setter object="multi_layout_view" property="layout-name">dual_landscape_bp</setter>
        <setter object="camera_mode_toggles" property="orientation">horizontal</setter>
        <setter object="camera_controls" property="orientation">horizontal</setter>
        <signal name="apply" handler="change_breakpoint" object="Camera" swapped="yes" />
      </object>
    </child>
    <child>
      <object class="GtkStack" id="stack">
        <property name="transition-type">crossfade</property>
        <property name="hhomogeneous">False</property>
        <property name="vhomogeneous">False</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkWindowHandle">
                <child>
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar"/>
                    </child>
                    <property name="content">
                      <object class="AdwSpinner">
                        <style>
                          <class name="dimmed"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">not-found</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                        <property name="tooltip_text" translatable="yes">Main Menu</property>
                        <property name="primary">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwStatusPage">
                    <property name="icon-name">camera-disabled-symbolic</property>
                    <property name="title" translatable="yes">No Camera Found</property>
                    <property name="description" translatable="yes">Connect a camera device</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">camera</property>
            <property name="child">
              <object class="AdwBottomSheet" id="bottom_sheet">
                <property name="full-width">False</property>
                <property name="content">
                  <object class="GtkWindowHandle">
                    <child>
                      <object class="GtkOverlay">
                        <child type="overlay">
                          <object class="GtkRevealer" id="recording_revealer">
                            <property name="halign">center</property>
                            <property name="valign">end</property>
                            <property name="transition-type">crossfade</property>
                            <child>
                              <object class="GtkLabel" id="recording_label">
                                <style>
                                  <class name="recording-label"/>
                                  <class name="heading"/>
                                  <class name="numeric"/>
                                  <class name="osd"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="AdwMultiLayoutView" id="multi_layout_view">
                            <child type="countdown-button">
                              <object class="GtkMenuButton">
                                <property name="menu-model">countdown_menu</property>
                                <property name="icon-name">camera-timer-symbolic</property>
                                <property name="valign">center</property>
                                <property name="halign">center</property>
                                <property name="tooltip-text" translatable="yes">Countdown</property>
                                <style>
                                  <class name="circular" />
                                  <class name="flat" />
                                </style>
                              </object>
                            </child>
                            <child type="primary-menu">
                              <object class="GtkMenuButton">
                                <property name="icon-name">open-menu-symbolic</property>
                                <property name="menu-model">primary_menu</property>
                                <property name="valign">center</property>
                                <property name="tooltip-text" translatable="yes">Main Menu</property>
                                <property name="primary">True</property>
                                <style>
                                  <class name="circular" />
                                  <class name="flat" />
                                </style>
                              </object>
                            </child>
                            <child type="camera-controls">
                              <object class="CameraControls" id="camera_controls">
                                <property name="orientation">vertical</property>
                              </object>
                            </child>
                            <child type="camera-mode-toggle">
                              <object class="AdwToggleGroup" id="camera_mode_toggles">
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <property name="active" bind-source="Camera" bind-property="capture-mode" bind-flags="sync-create|bidirectional"/>
                                <style>
                                  <class name="round" />
                                </style>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name">picture</property>
                                    <property name="icon-name">camera-photo-symbolic</property>
                                    <property name="tooltip" translatable="yes">Picture Mode</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="icon-name">camera-web-symbolic</property>
                                    <property name="tooltip" translatable="yes">Recording Mode</property>
                                    <property name="name">video</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="icon-name">qr-code-symbolic</property>
                                    <property name="tooltip" translatable="yes">QR Code Scanning Mode</property>
                                    <property name="name">qr-code</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwLayout">
                                <property name="name">single_portrait_bp</property>
                                <property name="content">
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="hexpand">True</property>
                                    <child>
                                      <object class="AdwBin">
                                        <property name="visible" bind-property="empty" bind-source="left-window-controls" bind-flags="sync-create|invert-boolean" />
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child>
                                          <object class="GtkWindowControls" id="left-window-controls">
                                            <property name="side">start</property>
                                            <property name="layout-manager">
                                              <object class="GtkBoxLayout">
                                                <property name="orientation">vertical</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">vertical</property>
                                        <property name="halign">end</property>
                                        <property name="hexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child type="start">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="GtkWindowControls">
                                                <property name="valign">center</property>
                                                <property name="side">end</property>
                                                <property name="layout-manager">
                                                  <object class="GtkBoxLayout">
                                                    <property name="orientation">vertical</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">primary-menu</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">camera-mode-toggle</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-controls</property>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">countdown-button</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwLayout">
                                <property name="name">dual_portrait_bp</property>
                                <property name="content">
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="hexpand">True</property>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">vertical</property>
                                        <property name="halign">start</property>
                                        <property name="vexpand">True</property>
                                        <style>
                                          <class name="startcontrolsframe" />
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child type="start">
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="hexpand">True</property>
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="GtkWindowControls">
                                                <property name="valign">center</property>
                                                <property name="layout-manager">
                                                  <object class="GtkBoxLayout">
                                                    <property name="orientation">vertical</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">primary-menu</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-mode-toggle</property>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">countdown-button</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">vertical</property>
                                        <property name="halign">end</property>
                                        <property name="hexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child type="start">
                                          <object class="GtkWindowControls">
                                            <property name="valign">center</property>
                                            <property name="side">end</property>
                                            <property name="layout-manager">
                                              <object class="GtkBoxLayout">
                                                <property name="orientation">vertical</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-controls</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwLayout">
                                <property name="name">single_landscape_bp</property>
                                <property name="content">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="vexpand">True</property>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="valign">start</property>
                                        <property name="hexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child type="start">
                                          <object class="GtkWindowControls">
                                            <property name="valign">center</property>
                                            <property name="side">start</property>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="hexpand">True</property>
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">primary-menu</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkWindowControls">
                                                <property name="side">end</property>
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="valign">end</property>
                                        <property name="hexpand">True</property>
                                        <property name="vexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                          <class name="bottom" />
                                        </style>
                                        <child type="start">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">countdown-button</property>
                                          </object>
                                        </child>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-controls</property>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-mode-toggle</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwLayout">
                                <property name="name">dual_landscape_bp</property>
                                <property name="content">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="vexpand">True</property>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="valign">start</property>
                                        <property name="hexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                        </style>
                                        <child type="start">
                                          <object class="GtkBox">
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="GtkWindowControls">
                                                <property name="valign">center</property>
                                                <property name="side">start</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">countdown-button</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-mode-toggle</property>
                                          </object>
                                        </child>
                                        <child type="end">
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="hexpand">True</property>
                                            <property name="halign">end</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">6</property>
                                            <child>
                                              <object class="AdwLayoutSlot">
                                                <property name="id">primary-menu</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkWindowControls">
                                                <property name="side">end</property>
                                                <property name="valign">center</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCenterBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="valign">end</property>
                                        <property name="hexpand">True</property>
                                        <property name="vexpand">True</property>
                                        <style>
                                          <class name="cameracontrols" />
                                          <class name="controlsframe" />
                                          <class name="bottom" />
                                        </style>
                                        <child type="center">
                                          <object class="AdwLayoutSlot">
                                            <property name="id">camera-controls</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="GtkButton" id="zoom_reset_button">
                            <property name="label">1.0×</property>
                            <property name="halign">center</property>
                            <property name="valign">start</property>
                            <property name="focus-on-click">False</property>
                            <property name="tooltip-text" translatable="yes">Current digital zoom; tap to reset</property>
                            <style>
                              <class name="zoom-indicator"/>
                              <class name="pill"/>
                              <class name="osd"/>
                              <class name="numeric"/>
                            </style>
                          </object>
                        </child>
                        <child type="overlay">
                          <object class="GtkButton" id="image_controls_overlay_button">
                            <property name="label" translatable="yes">Controls</property>
                            <property name="halign">end</property>
                            <property name="valign">start</property>
                            <property name="margin-top">18</property>
                            <property name="margin-end">18</property>
                            <property name="focus-on-click">False</property>
                            <property name="tooltip-text" translatable="yes">Open Image Controls</property>
                            <property name="action-name">win.image-controls</property>
                            <style>
                              <class name="image-controls-entry" />
                              <class name="pill" />
                              <class name="osd" />
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="FlashBin" id="flash_bin">
                            <child>
                              <object class="QrScreenBin" id="qr_screen_bin">
                                <child>
                                  <object class="GuidelinesBin" id="guidelines">
                                    <child>
                                      <object class="ApertureViewfinder" id="viewfinder"/>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="sheet">
                  <object class="GtkStack" id="sheet_stack">
                    <property name="transition-type">crossfade</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">qr</property>
                        <property name="child">
                          <object class="QrBottomSheet" id="qr_bottom_sheet">
                            <property name="width-request">360</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">image-controls</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">24</property>
                            <property name="margin-bottom">24</property>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Image Controls</property>
                                <property name="description" translatable="yes">Adjust the live preview and saved photo</property>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Manual focus position</property>
                                    <property name="subtitle" translatable="yes">Rear lens range 0–2; moving this locks autofocus</property>
                                    <child>
                                      <object class="GtkScale" id="focus_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">2</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">0</property>
                                            <property name="upper">2</property>
                                            <property name="value">1</property>
                                            <property name="step-increment">0.05</property>
                                            <property name="page-increment">0.2</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Exposure</property>
                                    <child>
                                      <object class="GtkScale" id="exposure_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">-1</property>
                                            <property name="upper">1</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">0.2</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Automatic exposure</property>
                                    <property name="subtitle" translatable="yes">Let the camera regulate shutter and analogue gain</property>
                                    <child>
                                      <object class="GtkSwitch" id="auto_exposure_switch">
                                        <property name="active">True</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Shutter (µs)</property>
                                    <property name="subtitle" translatable="yes">Manual exposure time; the sensor may clamp its limits</property>
                                    <child>
                                      <object class="GtkScale" id="shutter_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">0</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">100</property>
                                            <property name="upper">33333</property>
                                            <property name="value">8333</property>
                                            <property name="step-increment">100</property>
                                            <property name="page-increment">1000</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Analogue gain</property>
                                    <property name="subtitle" translatable="yes">Manual linear sensor gain; this is not a vendor ISO control</property>
                                    <child>
                                      <object class="GtkScale" id="gain_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">1</property>
                                            <property name="upper">16</property>
                                            <property name="value">1</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">1</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Colour</property>
                                    <child>
                                      <object class="GtkScale" id="saturation_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">0</property>
                                            <property name="upper">2</property>
                                            <property name="value">1.35</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">0.2</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Contrast</property>
                                    <child>
                                      <object class="GtkScale" id="contrast_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">0</property>
                                            <property name="upper">2</property>
                                            <property name="value">1.10</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">0.2</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Detail</property>
                                    <child>
                                      <object class="GtkScale" id="sharpness_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">0</property>
                                            <property name="upper">2</property>
                                            <property name="value">1</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">0.2</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Zoom</property>
                                    <child>
                                      <object class="GtkScale" id="zoom_scale">
                                        <property name="width-request">175</property>
                                        <property name="valign">center</property>
                                        <property name="digits">1</property>
                                        <property name="draw-value">True</property>
                                        <property name="value-pos">right</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment">
                                            <property name="lower">1</property>
                                            <property name="upper">4</property>
                                            <property name="value">1</property>
                                            <property name="step-increment">0.1</property>
                                            <property name="page-increment">0.5</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Hardware flash</property>
                                    <property name="subtitle" translatable="yes">Use the rear camera LEDs for a short photo pulse</property>
                                    <child>
                                      <object class="GtkSwitch" id="flash_switch">
                                        <property name="valign">center</property>
                                        <property name="tooltip-text" translatable="yes">Pulse the phone's rear flash LEDs when taking a photo</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Software HDR</property>
                                    <property name="subtitle" translatable="yes">Capture dark, normal and bright frames, then merge them</property>
                                    <child>
                                      <object class="GtkSwitch" id="hdr_switch">
                                        <property name="valign">center</property>
                                        <property name="tooltip-text" translatable="yes">Merge three exposure-bracketed frames into one JPEG</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="reset_image_controls">
                                <property name="label" translatable="yes">Reset</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Software HDR uses three rapid exposures. Moving subjects may show ghosting; hardware flash and manual exposure are disabled during the sequence.</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style>
                                  <class name="dim-label"/>
                                  <class name="caption"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">permission-denied</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                        <property name="tooltip_text" translatable="yes">Main Menu</property>
                        <property name="primary">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwStatusPage">
                    <property name="icon-name">camera-disabled-symbolic</property>
                    <property name="title" translatable="yes">Missing Camera Permission</property>
                    <property name="description" translatable="yes">Allow camera usage in Settings</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
  <menu id="countdown_menu">
    <section>
      <attribute name="label" translatable="yes">Countdown</attribute>
      <item>
        <attribute name="action">win.countdown</attribute>
        <attribute name="label" translatable="yes" comments="TRANSLATORS this indicates the countdown is disabled">None</attribute>
        <attribute name="target" type="i">0</attribute>
      </item>
      <item>
        <attribute name="action">win.countdown</attribute>
        <attribute name="label" translatable="yes" comments="TRANSLATORS this is time for a countdown in seconds">3s</attribute>
        <attribute name="target" type="i">3</attribute>
      </item>
      <item>
        <attribute name="action">win.countdown</attribute>
        <attribute name="label" translatable="yes" comments="TRANSLATORS this is time for a countdown in seconds">5s</attribute>
        <attribute name="target" type="i">5</attribute>
      </item>
      <item>
        <attribute name="action">win.countdown</attribute>
        <attribute name="label" translatable="yes" comments="TRANSLATORS this is time for a countdown in seconds">10s</attribute>
        <attribute name="target" type="i">10</attribute>
      </item>
    </section>
  </menu>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Image Controls</attribute>
        <attribute name="action">win.image-controls</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Advanced Snapshot</attribute>
        <attribute name="action">win.about</attribute>
      </item>
    </section>
  </menu>
</interface>
