# Contributor: Lolren <loren.bufanu@gmail.com>
maintainer="Lolren <loren.bufanu@gmail.com>"
pkgname=advanced-snapshot
pkgver=0.1.0
pkgrel=0
_commit="a73a3993263adb33604a1fad7f88d5e53e75f4c0"
pkgdesc="Mobile-first camera application with truthful manual controls"
url="https://github.com/lolren/advanced-snapshot"
arch="all"
license="GPL-3.0-or-later"
makedepends="
	cargo
	cargo-auditable
	desktop-file-utils
	glib-dev
	gst-plugins-bad-dev
	gst-plugins-base-dev
	gstreamer-dev
	gtk4.0-dev
	lcms2-dev
	libadwaita-dev
	libglycin-gtk4-dev
	libseccomp-dev
	meson
	pipewire-dev
	"
depends="
	glycin-image-rs
	gst-plugin-pipewire
	gst-plugins-bad
	gst-plugins-good
	gst-plugins-rs-gtk4
	gst-plugins-ugly
	pipewire
	pipewire-spa-libcamera
	"
subpackages="$pkgname-lang"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/lolren/advanced-snapshot/archive/$_commit.tar.gz
	cargo-auditable.patch
	"
options="net" # cargo vendor fetches locked Rust dependencies
builddir="$srcdir/$pkgname-$_commit"

prepare() {
	default_prepare

	mkdir -p .cargo
	cargo vendor --locked vendor > .cargo/config.toml
}

build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	cargo test --locked
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

